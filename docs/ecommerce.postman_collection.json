    {
      "name": "05 - Purchases",
      "item": [
        {
          "name": "Create Purchase Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "purchase-success-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": {{purchase_product_id}},\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/purchases",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "purchases"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"purchase_id\", body.id);",
                  "pm.test(\"Purchase is paid\", function () {",
                  "    pm.expect(body.status).to.eql(\"PAID\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Stock After Purchase",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{purchase_product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{purchase_product_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Stock is 8\", function () {",
                  "    pm.expect(body.stock).to.eql(8);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Purchase Idempotent Retry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "purchase-success-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": {{purchase_product_id}},\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/purchases",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "purchases"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Same purchase is returned\", function () {",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"purchase_id\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Idempotency Conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "purchase-success-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": {{purchase_product_id}},\n      \"quantity\": 3\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/purchases",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "purchases"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment Failure",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
